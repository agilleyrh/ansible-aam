worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /dev/stdout;
  sendfile on;
  keepalive_timeout 65;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;

  server {
    listen 8080;
    server_name _;

    root /opt/app-root/src;
    index index.html;

    location / {
      try_files $uri /index.html;
    }

    location /api/ {
      proxy_pass __AAM_API_UPSTREAM__/api/;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-RH-User $http_x_rh_user;
      proxy_set_header X-RH-Roles $http_x_rh_roles;
      proxy_set_header X-RH-Email $http_x_rh_email;
      proxy_set_header X-RH-Identity $http_x_rh_identity;
      proxy_read_timeout 120s;
    }

    location /docs {
      proxy_pass __AAM_API_UPSTREAM__/docs;
      proxy_set_header Host $host;
    }

    location /openapi.json {
      proxy_pass __AAM_API_UPSTREAM__/openapi.json;
      proxy_set_header Host $host;
    }

    location /redoc {
      proxy_pass __AAM_API_UPSTREAM__/redoc;
      proxy_set_header Host $host;
    }

    location = /healthz {
      access_log off;
      default_type text/plain;
      return 200 "ok\n";
    }
  }
}
